# Inference Node — Ollama läuft hier (GPU)
OLLAMA_URL=http://<inference-node-ip>:11434

# MCP Hub
MCP_HUB_URL=http://<mcp-hub-ip>:8080

# Modelle (Name wie in Ollama, z.B. "gemma3:12b" oder "qwen3:8b")
MAIN_MODEL=gemma3:12b
CODE_MODEL=qwen2.5-coder:7b
ROUTING_MODEL=qwen3:8b

# Name des Assistenten (erscheint im System-Prompt)
ASSISTANT_NAME=Assistant

# Wiki-Backend: TriliumNext ETAPI
TRILIUM_URL=http://<trilium-ip>:8080/etapi
TRILIUM_API_TOKEN=<etapi-token>
